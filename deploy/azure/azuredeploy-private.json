{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.2.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for Eve resources."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "eve-research",
      "minLength": 3,
      "maxLength": 32,
      "metadata": {
        "description": "Eve application name. The default is suitable for most deployments."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "ghcr.io/OWNER/REPOSITORY:beta",
      "metadata": {
        "description": "Canonical immutable Eve release image. Leave the default unless your organisation mirrors the image internally."
      }
    },
    "bootstrapEmail": {
      "type": "string",
      "metadata": {
        "description": "Email address for the first Eve administrator."
      }
    },
    "bootstrapPassword": {
      "type": "secureString",
      "minLength": 12,
      "metadata": {
        "description": "Temporary first-admin password (12+ characters). Change it after first login."
      }
    },
    "connectorSecret": {
      "type": "secureString",
      "minLength": 24,
      "metadata": {
        "description": "Generated automatically by Azure to protect stored connector credentials. Leave the generated default."
      },
      "defaultValue": "[newGuid()]"
    },
    "organisationName": {
      "type": "string",
      "defaultValue": "Eve research workspace",
      "maxLength": 120,
      "metadata": {
        "description": "Organisation or research workspace name."
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[toLower(substring(concat('eve', uniqueString(resourceGroup().id, deployment().name)), 0, 20))]",
      "minLength": 3,
      "maxLength": 24,
      "metadata": {
        "description": "Generated organisation storage account name. Leave the default unless your administrators require a specific name."
      }
    },
    "fileShareName": {
      "type": "string",
      "defaultValue": "evedata",
      "metadata": {
        "description": "Azure Files share used by Eve. Leave the default for standard deployments."
      }
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "[concat(parameters('appName'), '-env')]",
      "metadata": {
        "description": "Container Apps environment name. Leave the default for standard deployments."
      }
    },
    "databaseAdminPassword": {
      "type": "secureString",
      "minLength": 16,
      "metadata": {
        "description": "Generated automatically by Azure for Eve PostgreSQL. Leave the generated default."
      },
      "defaultValue": "[format('Eve9!{0}a', newGuid())]"
    },
    "postgresServerName": {
      "type": "string",
      "defaultValue": "[toLower(substring(concat('evepg', uniqueString(resourceGroup().id, deployment().name)), 0, 30))]",
      "minLength": 3,
      "maxLength": 63,
      "metadata": {
        "description": "Generated PostgreSQL server name. Leave the default unless your administrators require a specific name."
      }
    },
    "databaseName": {
      "type": "string",
      "defaultValue": "eve",
      "minLength": 1,
      "maxLength": 63,
      "metadata": {
        "description": "PostgreSQL database name. Leave the default for standard deployments."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 3,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "Maximum Eve application replicas. The default supports a small multi-user research team."
      }
    },
    "virtualNetworkName": {
      "type": "string",
      "defaultValue": "[concat(parameters('appName'), '-vnet')]",
      "metadata": {
        "description": "Private Eve virtual network. Leave the default unless your Azure team supplies an approved network design."
      }
    },
    "virtualNetworkAddressPrefix": {
      "type": "string",
      "defaultValue": "10.40.0.0/16",
      "metadata": {
        "description": "Private Eve VNet address range."
      }
    },
    "containerAppsSubnetName": {
      "type": "string",
      "defaultValue": "container-apps",
      "metadata": {
        "description": "Dedicated Container Apps infrastructure subnet."
      }
    },
    "containerAppsSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.40.0.0/24",
      "metadata": {
        "description": "Container Apps subnet range."
      }
    },
    "postgresSubnetName": {
      "type": "string",
      "defaultValue": "postgres",
      "metadata": {
        "description": "Dedicated PostgreSQL Flexible Server delegated subnet."
      }
    },
    "postgresSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.40.1.0/28",
      "metadata": {
        "description": "PostgreSQL subnet range."
      }
    },
    "privateEndpointSubnetName": {
      "type": "string",
      "defaultValue": "private-endpoints",
      "metadata": {
        "description": "Subnet for Azure service private endpoints."
      }
    },
    "privateEndpointSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.40.2.0/27",
      "metadata": {
        "description": "Private endpoint subnet range."
      }
    }
  },
  "variables": {
    "environmentStorageName": "eve-storage",
    "dataMountPath": "/data/eve",
    "publicOrigin": "[format('https://{0}.{1}', parameters('appName'), reference(resourceId('Microsoft.App/managedEnvironments', parameters('environmentName')), '2025-01-01').properties.defaultDomain)]",
    "virtualNetworkId": "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]",
    "containerAppsSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), parameters('containerAppsSubnetName'))]",
    "postgresSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), parameters('postgresSubnetName'))]",
    "privateEndpointSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), parameters('privateEndpointSubnetName'))]",
    "postgresPrivateDnsZoneName": "[format('eve-{0}.postgres.database.azure.com', uniqueString(resourceGroup().id))]",
    "filesPrivateDnsZoneName": "privatelink.file.core.windows.net",
    "environmentPrivateDnsZoneName": "[reference(resourceId('Microsoft.App/managedEnvironments', parameters('environmentName')), '2025-01-01').properties.defaultDomain]",
    "privateOrigin": "[format('https://{0}.{1}', parameters('appName'), reference(resourceId('Microsoft.App/managedEnvironments', parameters('environmentName')), '2025-01-01').properties.defaultDomain)]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[parameters('virtualNetworkName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('virtualNetworkAddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "[parameters('containerAppsSubnetName')]",
            "properties": {
              "addressPrefix": "[parameters('containerAppsSubnetPrefix')]",
              "delegations": [
                {
                  "name": "container-apps",
                  "properties": {
                    "serviceName": "Microsoft.App/environments"
                  }
                }
              ]
            }
          },
          {
            "name": "[parameters('postgresSubnetName')]",
            "properties": {
              "addressPrefix": "[parameters('postgresSubnetPrefix')]",
              "delegations": [
                {
                  "name": "postgres",
                  "properties": {
                    "serviceName": "Microsoft.DBforPostgreSQL/flexibleServers"
                  }
                }
              ]
            }
          },
          {
            "name": "[parameters('privateEndpointSubnetName')]",
            "properties": {
              "addressPrefix": "[parameters('privateEndpointSubnetPrefix')]",
              "privateEndpointNetworkPolicies": "Disabled"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": true,
        "publicNetworkAccess": "Disabled",
        "networkAcls": {
          "bypass": "None",
          "defaultAction": "Deny"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/default/{1}', parameters('storageAccountName'), parameters('fileShareName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "shareQuota": 100
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[variables('filesPrivateDnsZoneName')]",
      "location": "global",
      "properties": {}
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', variables('filesPrivateDnsZoneName'), 'eve-vnet-link')]",
      "location": "global",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('filesPrivateDnsZoneName'))]",
        "[variables('virtualNetworkId')]"
      ],
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[variables('virtualNetworkId')]"
        }
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2024-05-01",
      "name": "[concat(parameters('appName'), '-files-pe')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
        "[variables('virtualNetworkId')]"
      ],
      "properties": {
        "subnet": {
          "id": "[variables('privateEndpointSubnetId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "eve-files",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "groupIds": [
                "file"
              ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/{1}', concat(parameters('appName'), '-files-pe'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', concat(parameters('appName'), '-files-pe'))]",
        "[resourceId('Microsoft.Network/privateDnsZones', variables('filesPrivateDnsZoneName'))]"
      ],
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "files",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('filesPrivateDnsZoneName'))]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[variables('postgresPrivateDnsZoneName')]",
      "location": "global",
      "properties": {}
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', variables('postgresPrivateDnsZoneName'), 'eve-vnet-link')]",
      "location": "global",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('postgresPrivateDnsZoneName'))]",
        "[variables('virtualNetworkId')]"
      ],
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[variables('virtualNetworkId')]"
        }
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-01-01",
      "name": "[parameters('environmentName')]",
      "location": "[parameters('location')]",
      "properties": {
        "vnetConfiguration": {
          "infrastructureSubnetId": "[variables('containerAppsSubnetId')]",
          "internal": true
        },
        "publicNetworkAccess": "Disabled"
      },
      "dependsOn": [
        "[variables('virtualNetworkId')]"
      ]
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[variables('environmentPrivateDnsZoneName')]",
      "location": "global",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
      ],
      "properties": {}
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', variables('environmentPrivateDnsZoneName'), 'eve-vnet-link')]",
      "location": "global",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('environmentPrivateDnsZoneName'))]",
        "[variables('virtualNetworkId')]"
      ],
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[variables('virtualNetworkId')]"
        }
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones/A",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/*', variables('environmentPrivateDnsZoneName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('environmentPrivateDnsZoneName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
      ],
      "properties": {
        "TTL": 300,
        "aRecords": [
          {
            "ipv4Address": "[reference(resourceId('Microsoft.App/managedEnvironments', parameters('environmentName')), '2025-01-01').properties.staticIp]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', parameters('environmentName'), variables('environmentStorageName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', parameters('storageAccountName'), 'default', parameters('fileShareName'))]",
        "[resourceId('Microsoft.Network/privateEndpoints/privateDnsZoneGroups', concat(parameters('appName'), '-files-pe'), 'default')]",
        "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('filesPrivateDnsZoneName'), 'eve-vnet-link')]"
      ],
      "properties": {
        "azureFile": {
          "accountName": "[parameters('storageAccountName')]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').keys[0].value]",
          "shareName": "[parameters('fileShareName')]",
          "accessMode": "ReadWrite"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[parameters('postgresServerName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "administratorLogin": "eveadmin",
        "administratorLoginPassword": "[parameters('databaseAdminPassword')]",
        "version": "16",
        "storage": {
          "storageSizeGB": 32,
          "autoGrow": "Enabled"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Disabled",
          "delegatedSubnetResourceId": "[variables('postgresSubnetId')]",
          "privateDnsZoneArmResourceId": "[resourceId('Microsoft.Network/privateDnsZones', variables('postgresPrivateDnsZoneName'))]"
        }
      },
      "dependsOn": [
        "[variables('virtualNetworkId')]",
        "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('postgresPrivateDnsZoneName'), 'eve-vnet-link')]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', parameters('postgresServerName'), parameters('databaseName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresServerName'))]"
      ],
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', parameters('environmentName'), variables('environmentStorageName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', parameters('postgresServerName'), parameters('databaseName'))]",
        "[resourceId('Microsoft.Network/privateDnsZones/A', variables('environmentPrivateDnsZoneName'), '*')]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8787,
            "transport": "auto",
            "allowInsecure": false
          },
          "secrets": [
            {
              "name": "bootstrap-password",
              "value": "[parameters('bootstrapPassword')]"
            },
            {
              "name": "connector-secret",
              "value": "[parameters('connectorSecret')]"
            },
            {
              "name": "database-password",
              "value": "[parameters('databaseAdminPassword')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "eve",
              "image": "[parameters('containerImage')]",
              "resources": {
                "cpu": 1.0,
                "memory": "2Gi"
              },
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                },
                {
                  "name": "HOST",
                  "value": "0.0.0.0"
                },
                {
                  "name": "PORT",
                  "value": "8787"
                },
                {
                  "name": "RESEARCHOS_RELAY_DATA",
                  "value": "[variables('dataMountPath')]"
                },
                {
                  "name": "EVE_LIVE_MODE",
                  "value": "true"
                },
                {
                  "name": "EVE_TRUST_PROXY",
                  "value": "true"
                },
                {
                  "name": "EVE_DEPLOYMENT_MODE",
                  "value": "organisation-cloud"
                },
                {
                  "name": "EVE_CLOUD_PROVIDER",
                  "value": "azure"
                },
                {
                  "name": "EVE_DEFAULT_STORAGE_PROVIDER",
                  "value": "organisation"
                },
                {
                  "name": "EVE_STORAGE_PROFILE",
                  "value": "azure-private-files-postgres"
                },
                {
                  "name": "EVE_MAX_INSTANCES_HINT",
                  "value": "[string(parameters('maxReplicas'))]"
                },
                {
                  "name": "EVE_PUBLIC_ORIGIN",
                  "value": "[variables('publicOrigin')]"
                },
                {
                  "name": "EVE_BOOTSTRAP_EMAIL",
                  "value": "[parameters('bootstrapEmail')]"
                },
                {
                  "name": "EVE_ORG_NAME",
                  "value": "[parameters('organisationName')]"
                },
                {
                  "name": "EVE_BOOTSTRAP_PASSWORD",
                  "secretRef": "bootstrap-password"
                },
                {
                  "name": "EVE_CONNECTOR_SECRET",
                  "secretRef": "connector-secret"
                },
                {
                  "name": "EVE_ORG_STORAGE_ENABLED",
                  "value": "true"
                },
                {
                  "name": "EVE_ORG_STORAGE_LABEL",
                  "value": "Azure private organisation encrypted research storage"
                },
                {
                  "name": "EVE_STATE_BACKEND",
                  "value": "postgres"
                },
                {
                  "name": "PGHOST",
                  "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresServerName')), '2024-08-01').fullyQualifiedDomainName]"
                },
                {
                  "name": "PGPORT",
                  "value": "5432"
                },
                {
                  "name": "PGDATABASE",
                  "value": "[parameters('databaseName')]"
                },
                {
                  "name": "PGUSER",
                  "value": "eveadmin"
                },
                {
                  "name": "PGPASSWORD",
                  "secretRef": "database-password"
                },
                {
                  "name": "EVE_DATABASE_SSL",
                  "value": "require"
                },
                {
                  "name": "EVE_RELEASE_VERSION",
                  "value": "63.0.0"
                },
                {
                  "name": "EVE_AZURE_NETWORK_PROFILE",
                  "value": "private"
                }
              ],
              "volumeMounts": [
                {
                  "volumeName": "eve-data",
                  "mountPath": "[variables('dataMountPath')]"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": "[parameters('maxReplicas')]"
          },
          "volumes": [
            {
              "name": "eve-data",
              "storageType": "AzureFile",
              "storageName": "[variables('environmentStorageName')]"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "eveUrl": {
      "type": "string",
      "value": "[variables('privateOrigin')]"
    },
    "networkProfile": {
      "type": "string",
      "value": "private"
    },
    "virtualNetwork": {
      "type": "string",
      "value": "[parameters('virtualNetworkName')]"
    },
    "accessRequirement": {
      "type": "string",
      "value": "Connect from the Eve virtual network, a peered network, VPN or ExpressRoute. This deployment has no public Eve endpoint."
    },
    "storageAccount": {
      "type": "string",
      "value": "[parameters('storageAccountName')]"
    },
    "fileShare": {
      "type": "string",
      "value": "[parameters('fileShareName')]"
    },
    "databaseHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresServerName')), '2024-08-01').fullyQualifiedDomainName]"
    },
    "databaseName": {
      "type": "string",
      "value": "[parameters('databaseName')]"
    }
  }
}
