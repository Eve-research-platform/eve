# Public deployment
EVE_PUBLIC_ORIGIN=

# Microsoft Entra researcher SSO
EVE_ENTRA_TENANT_ID=
EVE_ENTRA_CLIENT_ID=
EVE_ENTRA_CLIENT_SECRET=
EVE_ENTRA_AUTO_JOIN=false
EVE_ENTRA_AUTO_JOIN_ROLE=researcher

# Optional local identity bootstrap
EVE_BOOTSTRAP_EMAIL=
EVE_BOOTSTRAP_PASSWORD=
EVE_BOOTSTRAP_NAME=
EVE_ORG_NAME=Eve workspace
EVE_SESSION_TTL_MS=43200000

# Granular collaboration
EVE_RESOURCE_PRESENCE_TTL_MS=45000
EVE_RESOURCE_LEASE_TTL_MS=75000

# Microsoft 365 email via Graph
EVE_M365_TENANT_ID=
EVE_M365_CLIENT_ID=
EVE_M365_CLIENT_SECRET=
EVE_M365_SENDER=
EVE_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# AI
EVE_AI_API_KEY=
EVE_AI_MODEL=gpt-5.6
EVE_AI_BASE_URL=https://api.openai.com/v1
EVE_AI_TIMEOUT_MS=45000


# Eve customer-owned cloud storage connectors
# Public URL used to construct OAuth redirect URIs, e.g. https://eve.department.gov.uk
EVE_CONNECTOR_SECRET=
EVE_GOOGLE_CLIENT_ID=
EVE_GOOGLE_CLIENT_SECRET=
EVE_GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/drive.file
EVE_MICROSOFT_CLIENT_ID=
EVE_MICROSOFT_CLIENT_SECRET=
EVE_MICROSOFT_TENANT_ID=organizations
EVE_MICROSOFT_SCOPES=openid profile email offline_access User.Read Sites.ReadWrite.All
